# ── PrepIntellect Environment Variables ──────────────────────────
# Copy this file to .env and fill in your real credentials.
# ⚠️  NEVER put real API keys in this file — it is committed to Git!

# MongoDB connection string
# Get from: https://cloud.mongodb.com → Database → Connect
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Google Gemini API key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key — used for Whisper transcription
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API configuration
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Server port
PORT=3001
